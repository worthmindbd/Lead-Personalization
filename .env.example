# Reoon Email Verifier — https://www.reoon.com/articles/api-documentation-of-reoon-email-verifier/
REOON_API_KEY=your_api_key_here

# Max emails to verify per calendar day (free tier = 500 daily credits)
REOON_DAILY_LIMIT=500

# Apify — LinkedIn recent-post enrichment (harvestapi/linkedin-profile-posts)
# https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# Firecrawl — reserved for a future tier-3 renderer (read by Config.from_env,
# not yet used by any code path). Safe to leave empty.
FIRECRAWL_API_KEY=

# Google Drive OAuth (rclone) — https://rclone.org/drive/#making-your-own-client-id
# Required for the Drive pipeline: rclone's bundled shared client ID is retired
# and heavily rate-limited, so create your own in Google Cloud Console.
# NOTE: rclone does NOT read this file. These are recorded here for reference only;
# the values that actually take effect are the ones you paste into `rclone config`
# (remote name "gdrive", storage type "drive"), which stores them in
# ~/.config/rclone/rclone.conf.
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here
